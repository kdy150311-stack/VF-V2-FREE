    local util = require(ReplicatedStorage.Modules.Utility)
    local originalRaycast = util.Raycast
    util.Raycast = function(self, origin, direction, range, ...)
        local silentEnabled = Toggles.SilentAimToggle and Toggles.SilentAimToggle.Value
        if not silentEnabled or type(range) ~= "number" or range < 100 then
            return originalRaycast(self, origin, direction, range, ...)
        end

        local hitChance = Options.SilentHitChanceSlider and Options.SilentHitChanceSlider.Value or 100
        if math.random(1, 100) > hitChance then
            return originalRaycast(self, origin, direction, range, ...)
        end

        local targetPart = getSilentAimTarget()
        if not targetPart then
            return originalRaycast(self, origin, direction, range, ...)
        end

        local targetPos = targetPart.Position
        local dirUnit = (targetPos - origin).Unit
        local targetDist = (targetPos - origin).Magnitude
        
        if targetDist > range then
            targetDist = range
            targetPos = origin + (dirUnit * range)
        end

        return {
            Position = targetPos,
            Distance = targetDist,
            Instance = targetPart,
            Material = targetPart.Material,
            Normal = -dirUnit
        }
    end
end)

