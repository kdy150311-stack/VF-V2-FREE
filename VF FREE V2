local function getSilentAimTarget()
    local centerPos = Vector2.new(Workspace.CurrentCamera.ViewportSize.X / 2, Workspace.CurrentCamera.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDist = Options.SilentFOVSlider and Options.SilentFOVSlider.Value or 300
    local targetPartName = Options.SilentPartDropdown and Options.SilentPartDropdown.Value or "Head"

    for _, entityModel in CollectionService:GetTagged("Entity") do
        if entityModel == LocalPlayer.Character then continue end
        local targetPart = entityModel:FindFirstChild(targetPartName, true)
        if not targetPart or not targetPart:IsA("BasePart") then continue end
        
        if isVisible(targetPart) then
            local screenPos, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local distFromCenter = (centerPos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if distFromCenter < bestDist then
                    bestDist = distFromCenter
                    bestTarget = targetPart
                end
            end
        end
    end
    return bestTarget
end

