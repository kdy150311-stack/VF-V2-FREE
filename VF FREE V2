local function toggleTableAttribute(attribute, value)
    pcall(function()
        for _, gcVal in pairs(getgc(true)) do
            if type(gcVal) == "table" and rawget(gcVal, attribute) then
                gcVal[attribute] = value
            end
        end
    end)
end

local function toggleMeleeAttributes(value)
    pcall(function()
        local meleeAttributes = { "AttackCooldown", "SwingCooldown", "MeleeCooldown", "Cooldown", "RecoveryTime", "ResetTime" }
        for _, gcVal in pairs(getgc(true)) do
            if type(gcVal) == "table" then
                for _, attr in ipairs(meleeAttributes) do
                    if rawget(gcVal, attr) then gcVal[attr] = value end
                end
            end
        end
    end)
end

