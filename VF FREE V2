local function getAimbotTarget()
    local closestTarget = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local useFOV = Toggles.AimbotFOVToggle and Toggles.AimbotFOVToggle.Value
    local fovRadius = Options.AimbotFOVSlider and Options.AimbotFOVSlider.Value or 150

    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemyAim(p) then
            local char = p.Character
            if char then
                local hum = char:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health > 0 then
                    local targetPartName = Options.AimbotPartDropdown and Options.AimbotPartDropdown.Value or "Head"
                    local targetPart = char:FindFirstChild(targetPartName) or char:FindFirstChild("Head")
                    
                    if targetPart and targetPart:IsA("BasePart") then
                        if isVisible(targetPart) then
                            local screenPos, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                if not useFOV or dist <= fovRadius then
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        closestTarget = targetPart
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

