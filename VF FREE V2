local loopTimeCounter = 0
local isAttackingPhase = false

local function runRageLogic()
    if not Toggles.RageToggle or not Toggles.RageToggle.Value or not UseItemRemote then return end

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return end
    
    if not RageModule.OriginalPosition then
        RageModule.OriginalPosition = hrp.Position
    end

    local hideTime = Options.HideTimeSlider and Options.HideTimeSlider.Value or 0.33
    local attackTime = Options.AttackTimeSlider and Options.AttackTimeSlider.Value or 0.05
    local totalCycle = hideTime + attackTime
    if totalCycle <= 0 then totalCycle = 0.38 end

    loopTimeCounter = (loopTimeCounter + RunService.Heartbeat:Wait()) % totalCycle
    isAttackingPhase = loopTimeCounter >= hideTime

    if not isAttackingPhase then
        pcall(function()
            hrp.CFrame = CFrame.new(0, 5000000000, 0)
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end)
        return
    else
        if RageModule.OriginalPosition then
            hrp.CFrame = CFrame.new(RageModule.OriginalPosition)
        end
    end

    local targetPlayer = getStickyTarget()
    if targetPlayer and targetPlayer.Character then
        local tc = targetPlayer.Character
        local tRoot = tc:FindFirstChild("HumanoidRootPart")
        local tHead = tc:FindFirstChild("HitboxHeadSmall") or tc:FindFirstChild("HitboxHead") or tc:FindFirstChild("Head")
        local objId = getEquippedObjId()
        
        if tRoot and tHead and objId then
            if not isProtected(tc) then
                local enemyWeapon = string.lower(getTargetEquippedWeaponName(targetPlayer))
                
                if enemyWeapon:find("katana") then
                    return
                end
                
                local fakePositionCF = tHead.CFrame * CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                
                if enemyWeapon:find("riot") or enemyWeapon:find("shield") then
                    fakePositionCF = tHead.CFrame * CFrame.new(0, 0.5, -2) * CFrame.Angles(math.rad(-90), 0, 0)
                elseif enemyWeapon:find("knife") or enemyWeapon:find("dagger") then
                    fakePositionCF = tHead.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                elseif enemyWeapon:find("bow") then
                    fakePositionCF = tHead.CFrame * CFrame.new(0, 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                end
                
                local currentRealCF = hrp.CFrame
                RageModule.OriginalPosition = currentRealCF.Position
                
                hrp.CFrame = fakePositionCF
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                
                local shootOrigin = tHead.Position + Vector3.new(0, 0.2, 0)
                local shotData = buildShotData(shootOrigin, tHead)
                
                if tick() >= RageModule.NextShootAt then
                    RageModule.NextShootAt = tick() + 0.015
                    pcall(function()
                        UseItemRemote:FireServer(objId, StartShootingEnum, shotData, nil)
                        UseItemRemote:FireServer(objId, StartShootingEnum, shotData, nil)
                        UseItemRemote:FireServer(objId, StartShootingEnum, shotData, nil)
                    end)
                end
                
                RunService:BindToRenderStep("_SoftRestore", 101, function()
                    hrp.CFrame = currentRealCF
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, math.min(hrp.Velocity.Y, 0), hrp.Velocity.Z)
                    RunService:UnbindFromRenderStep("_SoftRestore")
                end)
            end
        end
    else
        RageModule.LockedTarget = nil
    end
end

