local function isEnemy(player)
    if player == LocalPlayer then return false end
    local rageEnabled = Toggles.RageToggle and Toggles.RageToggle.Value
    if rageEnabled then
        local myTeam = LocalPlayer:GetAttribute("TeamID")
        local theirTeam = player:GetAttribute("TeamID")
        if myTeam == nil or theirTeam == nil then return true end
        return theirTeam ~= myTeam
    end
    return true
end

local function isProtected(character)
    if not character then return true end
    if character:FindFirstChild("InvincibilityParticles", true) then return true end
    if character:GetAttribute("SpawnProtection") == true or character:GetAttribute("Invincible") == true then
        return true
    end
    return false
end

local function getEquippedObjId()
    if not controllers then return nil end
    local ok, FighterCtrl = pcall(function() return require(controllers.FighterController) end)
    if not ok or not FighterCtrl or not FighterCtrl.LocalFighter then return nil end
    local item = FighterCtrl.LocalFighter.EquippedItem
    if not item then return nil end
    local okId, id = pcall(function() return item:Get("ObjectID") end)
    if okId and id then return id end
    local okData, idData = pcall(function() return item.Data and item.Data.ObjectID end)
    return okData and idData or nil
end

local function getTargetEquippedWeaponName(targetPlayer)
    pcall(function()
        if FighterController then
            local fighter = FighterController:GetFighter(targetPlayer)
            if fighter and fighter.EquippedItem then
                return fighter.EquippedItem.Name
            end
        end
    end)
    local char = targetPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:FindFirstChild("Handle") then
                return child.Name
            end
        end
    end
    return ""
end

local function getStickyTarget()
    if RageModule.LockedTarget and RageModule.LockedTarget.Character then
        local char = RageModule.LockedTarget.Character
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp and not isProtected(char) then
            return RageModule.LockedTarget
        else
            RageModule.LockedTarget = nil
        end
    end
    
    local bestTarget = nil
    local minDistance = math.huge
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, player in ipairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        if isProtected(char) then continue end
        
        if myHrp then
            local distToPlayer = (hrp.Position - myHrp.Position).Magnitude
            if distToPlayer > 600 then continue end
        end
        
        local screenPos, isVisibleTarget = Camera:WorldToViewportPoint(hrp.Position)
        if not isVisibleTarget then continue end
        
        local distance = (Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
        if distance < minDistance then
            minDistance = distance
            bestTarget = player
        end
    end
    
    RageModule.LockedTarget = bestTarget
    return bestTarget
end

local function buildShotData(originPos, targetPart)
    local targetPos = targetPart.Position
    local lookCF = CFrame.lookAt(originPos, targetPos)
    local lX, lY, lZ = lookCF:ToOrientation()
    local originStruct = {
        [utf8.char(0)] = originPos.X, [utf8.char(1)] = originPos.Y, [utf8.char(2)] = originPos.Z,
        [utf8.char(3)] = lX, [utf8.char(4)] = lY, [utf8.char(5)] = lZ,
    }
    local relCF = targetPart.CFrame:ToObjectSpace(CFrame.new(targetPos))
    local rX, rY, rZ = relCF:ToOrientation()
    return {
        [utf8.char(1)] = {
            [utf8.char(0)] = originStruct,
            [utf8.char(1)] = originStruct,
            [utf8.char(2)] = targetPart,
            [utf8.char(3)] = {
                [utf8.char(0)] = relCF.X, [utf8.char(1)] = relCF.Y, [utf8.char(2)] = relCF.Z,
                [utf8.char(3)] = rX, [utf8.char(4)] = rY, [utf8.char(5)] = rZ,
            },
        }
    }
end

